<?xml version="1.0" encoding="UTF-8"?>
<!-- Per-user install so the exe folder stays writable. Saved .ttl files go in that same folder. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="Titanium Timetables"
      Manufacturer="NextElement"
      Version="$(var.Version)"
      UpgradeCode="7C2A9E14-5B6F-4E38-9D21-1F0A6C8B4E77"
      Scope="perUser"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Titanium Timetables is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <util:CloseApplication
        Id="CloseTitaniumTimetables"
        Target="TitaniumTimetables.exe"
        CloseMessage="yes"
        EndSessionMessage="yes"
        RebootPrompt="no"
        TerminateProcess="0"
        Timeout="5" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="TitaniumTimetables">
          <Files Include="!(bindpath.SourceDir)\**" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenu" Guid="B8E4D1A2-6C55-4F09-8A17-3D9E2F6B0C41">
        <Shortcut
            Id="ApplicationStartMenuShortcut"
            Name="Titanium Timetables"
            Target="[INSTALLFOLDER]TitaniumTimetables.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <Shortcut
            Id="OpenTimetableFolder"
            Name="Timetable files"
            Target="[WindowsFolder]explorer.exe"
            Arguments="&quot;[INSTALLFOLDER]&quot;" />
        <RegistryValue
            Root="HKCU"
            Key="Software\TitaniumTimetables"
            Name="installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Classes\SchdTtl" Type="string" Value="School timetable" />
        <RegistryValue Root="HKCU" Key="Software\Classes\SchdTtl\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]TitaniumTimetables.exe&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKCU" Key="Software\Classes\SchdTtl\DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]TitaniumTimetables.exe&quot;,0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.ttl" Type="string" Value="SchdTtl" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
