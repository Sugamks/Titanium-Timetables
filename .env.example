# Copy to .env at the repo root. apps/api/.env is not read.
# Unset keys use the defaults in apps/api/app/config.py.
# apps/desktop/serve.py sets TTL_FILE and the data directory for the process.

# JWT_SECRET comes from the environment. In GitHub Actions use secrets.JWT_SECRET.
# JWT_SECRET=
# JWT_EXPIRE_MINUTES=480
# SCHEDULING_SERVICE_KEY=dev-scheduling-service-key

# ALLOW_DEV_LOGIN=true
# POC_MODE=true

# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1:8765,http://localhost:8765
# SPA_URL=http://localhost:5173
# API_URL=http://localhost:8000

# REDIS_URL=redis://localhost:6379/0

# Desktop launcher only. Ignored by pydantic if set only for uvicorn.
# SCHEDULING_HOST=127.0.0.1
# SCHEDULING_PORT=8765
# SCHEDULING_DATA_DIR=
# SCHEDULING_NO_BROWSER=1
# TTL_FILE=
